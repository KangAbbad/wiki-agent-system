{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_ROOT/hooks/provision.py\" >/dev/null 2>&1 || true; \"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_DATA/current/hooks/preflight.py\"",
            "timeout": 5,
            "statusMessage": "Preparing scoped Wiki context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_ROOT/hooks/provision.py\" >/dev/null 2>&1 || true; \"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_DATA/current/hooks/preflight.py\"",
            "timeout": 5,
            "statusMessage": "Checking scoped Wiki context for subagent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_ROOT/hooks/provision.py\" >/dev/null 2>&1 || true; \"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_DATA/current/hooks/preflight.py\"",
            "timeout": 3,
            "statusMessage": "Confirming Wiki preflight before local tools"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_ROOT/hooks/provision.py\" >/dev/null 2>&1 || true; \"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_DATA/current/hooks/preflight.py\"",
            "timeout": 45,
            "statusMessage": "Checking scoped Wiki knowledge and YouTube sources"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_ROOT/hooks/provision.py\" >/dev/null 2>&1 || true; \"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_DATA/current/hooks/preflight.py\"",
            "timeout": 3,
            "statusMessage": "Checkpointing Wiki state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_ROOT/hooks/provision.py\" >/dev/null 2>&1 || true; \"$PLUGIN_ROOT/hooks/launcher.sh\" \"$PLUGIN_DATA/current/hooks/preflight.py\"",
            "timeout": 5,
            "statusMessage": "Saving scoped Wiki capture"
          }
        ]
      }
    ]
  }
}
