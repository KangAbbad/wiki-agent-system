{
  "schema_version": 4,
  "enabled": true,
  "ambient_read": true,
  "suggest_writes": true,
  "require_explicit_write": true,
  "auto_capture": true,
  "capture": {
    "schema_version": 1,
    "status": "pending-curation",
    "required": ["outcome"],
    "fields": ["decisions", "artifacts", "verification", "sources", "confidence", "open_questions"],
    "redact_sensitive": true
  },
  "auto_canonicalize": "evidence_only",
  "redact_sensitive": true,
  "scope_resolution": "automatic",
  "knowledge_preflight": true,
  "evidence": {
    "schema_version": 1,
    "provenance_classes": ["caption", "web-extraction", "metadata", "machine-transcription", "none"],
    "lifecycle_states": ["acquired", "unverified", "verifying", "verified", "exhausted", "blocked"],
    "public_sources_only": true,
    "max_source_bytes": 524288,
    "max_attempts": 3,
    "max_retries": 3,
    "max_discovery_results": 3,
    "scheduled_drain_seconds": 4
  },
  "workspace_start": {
    "initialize_local_wiki": true,
    "empty_workspace_is_workspace_scope": true
  },
  "repo_scope": {
    "initialize_local_wiki": true,
    "signals": ["workspace_changes", "verification", "bug_investigation", "architecture", "api_contract", "schema", "dependency", "deployment"]
  },
  "retention": {
    "max_bytes": 1073741824,
    "queue_days": 30,
    "state_days": 30,
    "autosave_days": 10,
    "digest_days": 180,
    "trash_days": 7,
    "warn_percent": 70,
    "plan_percent": 85,
    "block_large_write_percent": 95
  },
  "workspace_topics": {},
  "topics": {}
}
