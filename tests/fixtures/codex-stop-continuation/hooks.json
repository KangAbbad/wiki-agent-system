{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$WIKI_PLUGIN_ROOT/hooks/launcher.sh\" \"$WIKI_PLUGIN_ROOT/hooks/preflight.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$WIKI_PLUGIN_ROOT/hooks/launcher.sh\" \"$WIKI_PLUGIN_ROOT/hooks/preflight.py\" | tee \"$CODEX_FIXTURE_USER_PROMPT_CONTEXT\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$WIKI_FIXTURE_HOOK\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$WIKI_PLUGIN_ROOT/hooks/launcher.sh\" \"$WIKI_PLUGIN_ROOT/hooks/preflight.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
